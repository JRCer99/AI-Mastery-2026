{
  "manifest_version": 3,
  "name": "JRC AI Summarizer",
  "version": "1.0",
  "description": "Summarize any webpage with Claude AI — Month 12 Capstone Project",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
